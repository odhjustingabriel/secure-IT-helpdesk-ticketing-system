# Copy to .env for local overrides. Do not commit real secrets.
SECRET_KEY=change-me-for-local-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DEFAULT_FROM_EMAIL=Secure IT Helpdesk <helpdesk@example.com>
MAX_REQUEST_BODY_BYTES=1048576
MAX_QUERY_STRING_LENGTH=2048
RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_ATTEMPTS=5
DEFAULT_RATE_LIMIT_ATTEMPTS=120
DEMO_ADMIN_PASSWORD=admin12345
DEMO_SUPPORT_PASSWORD=support12345
DEMO_USER_PASSWORD=user12345
